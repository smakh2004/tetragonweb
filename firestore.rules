rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // site owner (admin.html) — keep in sync with ADMIN_EMAILS in js/admin.js
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['smakh2004@outlook.com', 'smakh04@mail.ru'];
    }

    match /users/{uid} {
      // fields only the server (your Click Cloud Function) may set
      function locked() {
        return ['subscription', 'plan', 'paidAt', 'planExpires'];
      }

      // your own doc; the admin may read all (counts + revenue on admin.html)
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();

      // create your own doc, but you can't grant yourself premium
      allow create: if request.auth != null && request.auth.uid == uid
        && (!('subscription' in request.resource.data)
            || request.resource.data.subscription == 'free');

      // update your own doc (e.g. change display name, lastSeen), but you
      // can't touch the subscription fields
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(locked());

      allow delete: if false;
    }

    // ===== SITE STATS (visit counter for admin.html) =====
    // anyone may add exactly 1 visit; only the admin can read it
    match /stats/site {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['visits'])
        && request.resource.data.visits == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visits'])
        && request.resource.data.visits == resource.data.visits + 1;
      allow delete: if false;
    }

    // ===== LESSON GAMES (teacher-created multiple-choice lessons) =====
    match /lessonGames/{gameId} {
      // Any signed-in user may READ a lesson (needed to load & play it).
      allow read: if request.auth != null;

      // Create: must be signed in AND stamp the doc with your own uid as owner.
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;

      // Update / delete: only the owner of the lesson.
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      // Questions live in a subcollection under each lesson.
      match /questions/{questionId} {
        // Anyone signed in can read the questions (to play the lesson).
        allow read: if request.auth != null;

        // Only the lesson's owner can add/change/remove its questions.
        allow write: if request.auth != null
          && get(/databases/$(database)/documents/lessonGames/$(gameId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
